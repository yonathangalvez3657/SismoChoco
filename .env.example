# ==============================================================================
# SismoChocó — Plantilla de Variables de Entorno (Producción / Local)
# ==============================================================================

# Entorno de Ejecución (production | development)
ENVIRONMENT=production

# Supabase Cloud Database (PostGIS) — completar en panel de secretos del hosting
SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
SUPABASE_KEY=REPLACE_WITH_SUPABASE_SERVICE_OR_ANON_KEY

# Token Secreto para operaciones administrativas (/api/sismos/reload, /api/sismos/sync)
ADMIN_SECRET_TOKEN=REPLACE_WITH_STRONG_RANDOM_SECRET

# Orígenes Permitidos CORS (separados por coma)
ALLOWED_ORIGINS=https://sismochoco.onrender.com,http://localhost:8000,http://127.0.0.1:8000

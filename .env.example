# ==============================================================================
# SismoChocó — Variables de Entorno (Producción / Local)
# ==============================================================================

# Entorno de Ejecución (production | development)
ENVIRONMENT=production

# Supabase Cloud Database (PostGIS)
SUPABASE_URL=https://tu-proyecto.supabase.co
# NOTA: En despliegue real (Render / Railway / Fly.io / AWS), inyectar SUPABASE_KEY en el panel de variables de entorno / secrets
SUPABASE_KEY=tu_supabase_service_role_o_anon_key_aqui

# Token Secreto para operaciones administrativas (/api/sismos/reload, /api/sismos/sync)
ADMIN_SECRET_TOKEN=sismochoco_secure_admin_2026

# Orígenes Permitidos CORS (separados por coma)
ALLOWED_ORIGINS=https://sismochoco.ucaldas.edu.co,https://sismochoco.vercel.app,http://localhost:8000,http://127.0.0.1:8000
